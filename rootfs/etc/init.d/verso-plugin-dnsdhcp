#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# SPDX-FileCopyrightText: 2026 Mono Technologies Inc.

USE_PROCD=1
START=93
STOP=12

USER_ENTRY='verso-plugin-dnsdhcp:x:6011:6000:Verso DNS and DHCP plugin:/var/run/verso:/bin/false'

start_service() {
	# The plugin's own uid, no other plugin's (ADR-007). An entry that says
	# otherwise is replaced, and the socket the old uid left goes with it: the
	# sticky runtime directory would not let the new uid remove it.
	if ! grep -qxF "$USER_ENTRY" /etc/passwd 2>/dev/null; then
		sed -i '/^verso-plugin-dnsdhcp:/d' /etc/passwd
		echo "$USER_ENTRY" >> /etc/passwd
		rm -f /var/run/verso/dnsdhcp.sock
	fi

	mkdir -p /var/run/verso
	chown root:verso /var/run/verso
	chmod 1770 /var/run/verso

	procd_open_instance dnsdhcp
	procd_set_param command /usr/bin/verso-plugin-dnsdhcp
	procd_set_param user verso-plugin-dnsdhcp
	procd_set_param group verso
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# The page's blocklist switch writes adblock's config, and adblock sets no
# trigger of its own, so an applied change would wait for a reboot.
service_triggers() {
	procd_add_config_trigger "config.change" "adblock" /etc/init.d/adblock reload
}
